# Shared by both the web (FastAPI) and worker services — set identically on both
# Railway services so they see the same volume and database.

# Root of the persistent volume: uploads-in-progress live at $SYSDX_DATA_ROOT/uploads,
# extracted sysdiagnose cases at $SYSDX_DATA_ROOT/cases. Mount a Railway volume here.
SYSDX_DATA_ROOT=/data

# Postgres connection string (Railway's Postgres plugin provides DATABASE_URL — map it
# to this var, or point at Postgres directly). Defaults to a local sqlite file if unset,
# which is fine for local dev but not for a multi-service Railway deploy.
SYSDX_DATABASE_URL=postgresql://user:password@host:5432/sysdx

# Comma-separated list of origins allowed to call the API cross-origin. Only needed when
# running the Vite dev server separately from the backend; in production the backend
# serves the built frontend itself, so no cross-origin requests happen.
SYSDX_CORS_ORIGINS=http://localhost:5173

# Bytes per upload chunk (default 8MB).
SYSDX_CHUNK_SIZE_BYTES=8388608

# How often (seconds) the worker polls the jobs table for new work.
SYSDX_WORKER_POLL_INTERVAL=2
